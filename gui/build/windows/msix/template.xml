<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="crdl-gui.exe"
        Arguments=""
        InstallLocation="C:\Program Files\CuteTenshii\Crunchyroll Downloader">
    </Installer>
    <PackageInformation
        PackageName="Crunchyroll Downloader"
        PackageDisplayName="Crunchyroll Downloader"
        PublisherName="CN=CuteTenshii"
        PublisherDisplayName="CuteTenshii"
        Version="0.1.0.0"
        PackageDescription="Download Crunchyroll episodes as MKV files">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.cutetenshii.crunchyroll-downloader"
                Description="Download Crunchyroll episodes as MKV files"
                DisplayName="Crunchyroll Downloader"
                ExecutableName="crdl-gui.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Crunchyroll Downloader</DisplayName>
            <PublisherDisplayName>CuteTenshii</PublisherDisplayName>
            <Description>Download Crunchyroll episodes as MKV files</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="crdl-gui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
